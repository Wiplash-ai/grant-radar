{
  "manifest_version": 3,
  "name": "Grant Grinder",
  "version": "0.5.1",
  "description": "Keep a draggable federal-grant search widget beside the work already in your browser.",
  "homepage_url": "https://labs.wiplash.ai/grants",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://labs.wiplash.ai/grants/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Grant Grinder widget",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["widget.html", "widget.css", "widget.js", "icons/radar-mark.svg"],
    "matches": ["<all_urls>"],
    "use_dynamic_url": true
  }],
  "options_page": "options.html"
}
